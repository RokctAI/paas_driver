*.mocks.dart
# The guided tour's generated steps file is deliberately committed so the
# repo analyzes without running the merge (CI regenerates it in-workspace
# on every tour run but only commits marketing/tour outputs).
!integration_test/tour_steps.g.dart

# Coverage reports
/coverage/

# App constants
#lib/app_constants.dart
#lib/infrastructure/services/app_constants.dart

# The host's root lib/ is generated by compose on every build - main.dart
# included - so none of it is tracked. Anything app-specific belongs in a
# manifest (app_routes, or host_routes in composer.json), which IS tracked.
# Anchored to the repo root on purpose: an unanchored lib/ also matched the
# lib/ inside every vendored SDK under .rokct/cache/, so CI commit-backs
# stripped the code out of the tracked caches (see .rokct/cache/.gitignore).
/lib/

# Python bytecode from running the .rokct compose/install scripts.
.rokct/__pycache__/
# Render-strip harness output (test/render/render_screen_test.dart writes the
# PNG + rect JSON here; the composed page is a CI artifact, never a commit).
/out/
