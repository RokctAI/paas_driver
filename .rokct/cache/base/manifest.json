{
  "name": "base_sdk",
  "version": "1.0.0",
  "home_page": "templates/routes/route_pages.dart",
  "installs": [
    {
      "from": "templates/main.dart",
      "to": "lib/main.dart"
    },
    {
      "from": "templates/app_widget.dart",
      "to": "lib/presentation/app_widget.dart"
    },
    {
      "from": "templates/routes/app_router.dart",
      "to": "lib/presentation/routes/app_router.dart"
    },
    {
      "from": "templates/routes/route_pages.dart",
      "to": "lib/presentation/routes/route_pages.dart"
    },
    {
      "from": "templates/pubspec.yaml",
      "to": "pubspec.yaml"
    },
    {
      "from": "templates/analysis_options.yaml",
      "to": "analysis_options.yaml"
    },
    {
      "from": "templates/flutter_native_splash.yaml",
      "to": "flutter_native_splash.yaml"
    },
    {
      "from": "templates/android",
      "to": "android"
    },
    {
      "from": "templates/ios",
      "to": "ios"
    },
    {
      "from": "templates/assets",
      "to": "assets"
    },
    {
      "from": "templates/theme",
      "to": "lib/presentation/theme"
    }
  ],
  "routes": [
    {
      "path": "/",
      "page": "SplashRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/route_pages.dart"
    },
    {
      "path": "/no-connection",
      "page": "NoConnectionRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/route_pages.dart"
    },
    {
      "path": "/closed",
      "page": "ClosedRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/route_pages.dart"
    },
    {
      "path": "/ui-type",
      "page": "UiTypeRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/route_pages.dart"
    }
  ],
  "integrations": [],
  "app_routes": [
    {
      "method": "replaceSplashRoute",
      "body": "context.router.replace(SplashRoute());",
      "imports": [
        "import 'package:auto_route/auto_route.dart';",
        "import 'package:${package}/presentation/routes/app_router.dart';"
      ]
    },
    {
      "method": "replaceNoConnectionRoute",
      "body": "context.router.replace(NoConnectionRoute());",
      "imports": [
        "import 'package:auto_route/auto_route.dart';",
        "import 'package:${package}/presentation/routes/app_router.dart';"
      ]
    },
    {
      "method": "replaceClosedRoute",
      "body": "context.router.replace(ClosedRoute());",
      "imports": [
        "import 'package:auto_route/auto_route.dart';",
        "import 'package:${package}/presentation/routes/app_router.dart';"
      ]
    },
    {
      "method": "replaceUiTypeRoute",
      "body": "context.router.replace(UiTypeRoute());",
      "imports": [
        "import 'package:auto_route/auto_route.dart';",
        "import 'package:${package}/presentation/routes/app_router.dart';"
      ]
    }
  ]
}
