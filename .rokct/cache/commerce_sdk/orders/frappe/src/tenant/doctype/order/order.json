{
    "doctype": "DocType",
    "name": "Order",
    "engine": "InnoDB",
    "is_submittable": 1,
    "issingle": 0,
    "istable": 0,
    "module": "paas",
    "permissions": [
        {
            "create": 1,
            "delete": 1,
            "email": 1,
            "export": 1,
            "print": 1,
            "read": 1,
            "report": 1,
            "role": "System Manager",
            "share": 1,
            "write": 1,
            "submit": 1,
            "cancel": 1
        }
    ],
    "sort_field": "modified",
    "sort_order": "DESC",
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "user",
            "fieldtype": "Link",
            "label": "User",
            "options": "User",
            "reqd": 1
        },
        {
            "fieldname": "shop",
            "fieldtype": "Link",
            "label": "Shop",
            "options": "Shop",
            "reqd": 1
        },
        {
            "fieldname": "deliveryman",
            "fieldtype": "Link",
            "label": "Deliveryman",
            "options": "User"
        },
        {
            "fieldname": "waiter",
            "fieldtype": "Link",
            "label": "Waiter",
            "options": "User"
        },
        {
            "fieldname": "cook",
            "fieldtype": "Link",
            "label": "Cook",
            "options": "User"
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "New\nAccepted\nCooking\nReady\nShipped\nDelivered\nCancelled\nPaid\nFailed",
            "default": "New"
        },
        {
            "fieldname": "delivery_type",
            "fieldtype": "Data",
            "label": "Delivery Type"
        },
        {
            "fieldname": "currency",
            "fieldtype": "Link",
            "label": "Currency",
            "options": "Currency"
        },
        {
            "fieldname": "rate",
            "fieldtype": "Float",
            "label": "Rate"
        },
        {
            "fieldname": "delivery_fee",
            "fieldtype": "Currency",
            "label": "Delivery Fee"
        },
        {
            "fieldname": "waiter_fee",
            "fieldtype": "Currency",
            "label": "Waiter Fee"
        },
        {
            "fieldname": "tax",
            "fieldtype": "Currency",
            "label": "Tax"
        },
        {
            "fieldname": "commission_fee",
            "fieldtype": "Currency",
            "label": "Commission Fee"
        },
        {
            "fieldname": "service_fee",
            "fieldtype": "Currency",
            "label": "Service Fee"
        },
        {
            "fieldname": "total_discount",
            "fieldtype": "Currency",
            "label": "Total Discount"
        },
        {
            "fieldname": "coupon_code",
            "fieldtype": "Data",
            "label": "Coupon Code"
        },
        {
            "fieldname": "location",
            "fieldtype": "Data",
            "label": "Location"
        },
        {
            "fieldname": "address",
            "fieldtype": "Data",
            "label": "Address"
        },
        {
            "fieldname": "phone",
            "fieldtype": "Data",
            "label": "Phone"
        },
        {
            "fieldname": "username",
            "fieldtype": "Data",
            "label": "Username"
        },
        {
            "fieldname": "delivery_date",
            "fieldtype": "Date",
            "label": "Delivery Date"
        },
        {
            "fieldname": "delivery_time",
            "fieldtype": "Time",
            "label": "Delivery Time"
        },
        {
            "fieldname": "note",
            "fieldtype": "Text",
            "label": "Note"
        },
        {
            "fieldname": "total_price",
            "fieldtype": "Currency",
            "label": "Total Price"
        },
        {
            "fieldname": "payment_status",
            "fieldtype": "Select",
            "label": "Payment Status",
            "options": "Pending\nPaid\nFailed\nCredit"
        },
        {
            "fieldname": "cod_collected_amount",
            "fieldtype": "Currency",
            "label": "COD Collected Amount",
            "read_only": 1,
            "description": "Cash amount the deliveryman confirmed receiving on delivery."
        },
        {
            "fieldname": "pos_paid_amount",
            "fieldtype": "Currency",
            "label": "POS Paid Amount",
            "read_only": 1,
            "description": "Amount the customer paid at the till when a seller (POS) order was completed as Credit; the credit balance the wallet auto-pay sweeps is total_price minus this."
        },
        {
            "fieldname": "credit_collected_amount",
            "fieldtype": "Currency",
            "label": "Credit Collected Amount",
            "read_only": 1,
            "description": "Cumulative cash the deliveryman has collected against this order after it was converted to Credit; each collection is credited to the customer's wallet as a top-up."
        },
        {
            "fieldname": "custom_payment_transaction_id",
            "fieldtype": "Data",
            "label": "Payment Transaction ID"
        },
        {
            "fieldname": "order_items",
            "fieldtype": "Table",
            "label": "Order Items",
            "options": "Order Item",
            "reqd": 1
        },
        {
            "fieldname": "tip",
            "fieldtype": "Currency",
            "label": "Tip",
            "default": "0"
        },
        {
            "fieldname": "cashback_amount",
            "fieldtype": "Currency",
            "label": "Cashback Amount",
            "default": "0"
        },
        {
            "fieldname": "offline_uuid",
            "fieldtype": "Data",
            "label": "Offline UUID",
            "unique": 1
        },
        {
            "fieldname": "quoted_total",
            "fieldtype": "Currency",
            "label": "Quoted Total",
            "default": "0",
            "description": "The total amount quoted/authorized at checkout, including substitution buffers."
        },
        {
            "fieldname": "contains_adult_items",
            "fieldtype": "Check",
            "label": "Contains Adult Items",
            "default": "0",
            "read_only": 1,
            "description": "Set automatically when any order item's Product is flagged 18+ (adults only)."
        },
        {
            "fieldname": "age_verified",
            "fieldtype": "Check",
            "label": "Age Verified",
            "default": "0",
            "read_only": 1
        },
        {
            "fieldname": "age_verified_at",
            "fieldtype": "Datetime",
            "label": "Age Verified At",
            "read_only": 1
        },
        {
            "fieldname": "age_verified_by",
            "fieldtype": "Link",
            "label": "Age Verified By",
            "options": "User",
            "read_only": 1
        },
        {
            "fieldname": "settled",
            "fieldtype": "Check",
            "label": "Settled",
            "default": "0",
            "read_only": 1,
            "description": "Set once the Delivered + Paid wallet settlement (shop credit, commission bill, delivery fee, COD debit) has been posted; guards against double settlement."
        },
        {
            "fieldname": "settled_at",
            "fieldtype": "Datetime",
            "label": "Settled At",
            "read_only": 1
        },
        {
            "fieldname": "credit_settled",
            "fieldtype": "Check",
            "label": "Credit Settled",
            "default": "0",
            "read_only": 1,
            "description": "Set when the driver and platform shares were settled at credit delivery, fronted by the shop (shop debited delivery fee + item commission + service fee; driver credited fee minus delivery commission) so neither carries the credit risk. The later Paid settlement then credits the shop the FULL total_price and touches nobody else."
        },
        {
            "fieldname": "credit_settled_at",
            "fieldtype": "Datetime",
            "label": "Credit Settled At",
            "read_only": 1
        },
        {
            "fieldname": "collected_in_person",
            "fieldtype": "Check",
            "label": "Collected In Person",
            "default": "0",
            "read_only": 1,
            "description": "Set when a DELIVERY order was handed to the customer over the counter and converted to Pickup by the seller (convert_delivery_to_collected). The goods are never withheld, so this is recorded after the fact rather than chosen at placement."
        },
        {
            "fieldname": "collect_fee_refunded",
            "fieldtype": "Currency",
            "label": "Collect Fee Refunded",
            "default": "0",
            "read_only": 1,
            "description": "How much delivery fee went back to the customer's wallet when the order was collected in person. Nonzero only when NO driver had been assigned; with a driver the fee is kept and paid to him as a callout, and this stays 0."
        },
        {
            "fieldname": "callout_settled",
            "fieldtype": "Check",
            "label": "Callout Settled",
            "default": "0",
            "read_only": 1,
            "hidden": 1,
            "description": "Set once the assigned deliveryman has been paid his callout for an order the customer collected in person; guards against paying him a second time when the order later reaches Delivered."
        },
        {
            "fieldname": "callout_settled_at",
            "fieldtype": "Datetime",
            "label": "Callout Settled At",
            "read_only": 1,
            "hidden": 1
        }
    ]
}