{
    "doctype": "DocType",
    "name": "Order Refund",
    "engine": "InnoDB",
    "is_submittable": 0,
    "issingle": 0,
    "istable": 0,
    "module": "paas",
    "permissions": [
        {
            "create": 1,
            "delete": 1,
            "email": 1,
            "export": 1,
            "print": 1,
            "read": 1,
            "report": 1,
            "role": "System Manager",
            "share": 1,
            "write": 1
        }
    ],
    "sort_field": "modified",
    "sort_order": "DESC",
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "user",
            "fieldtype": "Link",
            "label": "User",
            "options": "User"
        },
        {
            "fieldname": "order",
            "fieldtype": "Link",
            "label": "Order",
            "options": "Order",
            "reqd": 1
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Pending\nAccepted\nCanceled",
            "default": "Pending"
        },
        {
            "fieldname": "amount",
            "fieldtype": "Currency",
            "label": "Amount"
        },
        {
            "fieldname": "cause",
            "fieldtype": "Text",
            "label": "Cause",
            "reqd": 1
        },
        {
            "fieldname": "answer",
            "fieldtype": "Text",
            "label": "Answer"
        },
        {
            "fieldname": "clawback_settled",
            "fieldtype": "Check",
            "label": "Clawback Settled",
            "default": "0",
            "read_only": 1,
            "description": "Set once the approval's wallet moves (buyer credit, shop clawback, commission reversal) have been posted; guards against double refunds on re-approval."
        },
        {
            "fieldname": "clawback_settled_at",
            "fieldtype": "Datetime",
            "label": "Clawback Settled At",
            "read_only": 1
        },
        {
            "fieldname": "clawback_amount",
            "fieldtype": "Currency",
            "label": "Clawback Amount",
            "read_only": 1,
            "description": "The amount actually credited back to the buyer for this refund (may be less than requested; cumulative refunds are capped at what the buyer paid)."
        }
    ]
}